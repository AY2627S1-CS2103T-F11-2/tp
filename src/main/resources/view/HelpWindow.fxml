<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.Scene?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.layout.VBox?>
<?import javafx.stage.Stage?>

<fx:root resizable="true" title="Help" type="javafx.stage.Stage" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
  <icons><Image url="@/images/help_icon.png" /></icons>
  <scene>
    <Scene>
      <stylesheets><URL value="@HelpWindow.css" /></stylesheets>
      <VBox fx:id="helpMessageContainer" spacing="12" prefWidth="600">
        <padding><Insets top="15" right="15" bottom="15" left="15" /></padding>
        <ScrollPane fitToWidth="true" prefViewportHeight="320" VBox.vgrow="ALWAYS">
          <content>
            <Label fx:id="quickReference" wrapText="true" style="-fx-padding: 10;" />
          </content>
        </ScrollPane>
        <Label fx:id="helpMessage" wrapText="true" />
        <Button fx:id="copyButton" mnemonicParsing="false" onAction="#copyUrl" text="Copy URL" />
      </VBox>
    </Scene>
  </scene>
</fx:root>

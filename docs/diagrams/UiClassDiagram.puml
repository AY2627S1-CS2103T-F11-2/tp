@startuml
!pragma layout smetana
!include style.puml
hide empty members
skinparam arrowThickness 1.1
skinparam arrowColor UI_COLOR_T4
skinparam classBackgroundColor UI_COLOR_T4
skinparam nodesep 35
skinparam ranksep 45

package UI <<Rectangle>> {
interface Ui
abstract class UiPart
class UiManager
class MainWindow
class HelpWindow
class EquipmentListPanel
class EquipmentCard
class ResultDisplay
class CommandBox
class StatusBarFooter
}

package "Logic" as LogicPackage <<Rectangle>> {
interface Logic
}

package "Model" as ModelPackage <<Rectangle>> {
class Equipment #9D0012
}

UiManager ..|> Ui
UiManager --> "0..1" MainWindow : mainWindow
UiManager --> "1" Logic : logic
MainWindow --> "1" Logic : logic
MainWindow --> "1" HelpWindow : helpWindow
MainWindow --> "0..1" EquipmentListPanel : equipmentListPanel
MainWindow --> "0..1" ResultDisplay : resultDisplay
MainWindow ..> CommandBox : creates
MainWindow ..> StatusBarFooter : creates
EquipmentListPanel ..> EquipmentCard : creates
EquipmentListPanel ..> Equipment : observes
EquipmentCard ..> Equipment : reads

MainWindow --|> UiPart
HelpWindow --|> UiPart
EquipmentListPanel --|> UiPart
EquipmentCard --|> UiPart
ResultDisplay --|> UiPart
CommandBox --|> UiPart
StatusBarFooter --|> UiPart


@enduml

@startuml
!include style.puml
skinparam ArrowFontStyle plain

box Model MODEL_COLOR_T1
participant ":Model" as Model MODEL_COLOR
participant ":VersionedClubLogisticsData" as VersionedClubLogisticsData MODEL_COLOR
end box

[-> Model : undoClubLogisticsData()
activate Model

Model -> VersionedClubLogisticsData : undo()
activate VersionedClubLogisticsData

VersionedClubLogisticsData -> VersionedClubLogisticsData :resetData(ReadOnlyClubLogisticsData)
VersionedClubLogisticsData --> Model :
deactivate VersionedClubLogisticsData

[<-- Model
deactivate Model

@enduml

@startuml
!include style.puml
skinparam ArrowFontStyle plain

box Logic LOGIC_COLOR_T1
participant ":LogicManager" as LogicManager LOGIC_COLOR
participant ":ClubLogisticsParser" as ClubLogisticsParser LOGIC_COLOR
participant "u:UndoCommand" as UndoCommand LOGIC_COLOR
end box

box Model MODEL_COLOR_T1
participant ":Model" as Model MODEL_COLOR
end box
[-> LogicManager : execute(undo)
activate LogicManager

LogicManager -> ClubLogisticsParser : parseCommand(undo)
activate ClubLogisticsParser

create UndoCommand
ClubLogisticsParser -> UndoCommand
activate UndoCommand

UndoCommand --> ClubLogisticsParser
deactivate UndoCommand

ClubLogisticsParser --> LogicManager : u
deactivate ClubLogisticsParser

LogicManager -> UndoCommand : execute()
activate UndoCommand

UndoCommand -> Model : undoClubLogisticsData()
activate Model

Model --> UndoCommand
deactivate Model

UndoCommand --> LogicManager : result
deactivate UndoCommand
UndoCommand -[hidden]-> LogicManager : result
destroy UndoCommand

[<--LogicManager
deactivate LogicManager
@enduml

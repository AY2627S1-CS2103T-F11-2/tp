@startuml
!include style.puml
skinparam arrowThickness 1.1
skinparam arrowColor LOGIC_COLOR_T4
skinparam classBackgroundColor LOGIC_COLOR
skinparam linetype polyline
skinparam nodesep 35
skinparam ranksep 40

abstract class Command
class XYZCommand

package "Parser classes" {
    interface Parser <<interface>>
    class ClubLogisticsParser
    class XYZCommandParser

    Parser -[hidden]right-> ClubLogisticsParser
}

ClubLogisticsParser .down.> XYZCommandParser : <<create>>
ClubLogisticsParser ..> Command : <<use>>
XYZCommandParser .up.|> Parser
XYZCommandParser ..> XYZCommand : <<create>>
XYZCommand -up-|> Command

legend bottom
  XYZCommandParser and XYZCommand represent the nine concrete pairs listed in the guide.
  Parser<T extends Command> defines parse(String): T.
endlegend
@enduml

@startuml
!include style.puml
skinparam arrowThickness 1.1
skinparam arrowColor MODEL_COLOR
skinparam classBackgroundColor MODEL_COLOR

package Model as ModelPackage <<Rectangle>> {
Class "<<interface>>\nReadOnlyClubLogisticsData" as ReadOnlyClubLogisticsData
Class "<<interface>>\nReadOnlyUserPrefs" as ReadOnlyUserPrefs
Class "<<interface>>\nModel" as Model
Class ClubLogisticsData
Class ModelManager
Class UserPrefs
Class UniqueEquipmentList
Class Equipment
Class EquipmentId
Class EquipmentName
Enum EquipmentStatus
Class BorrowerName
Class "FilteredList<Equipment>" as FilteredEquipment
}

ClubLogisticsData .up.|> ReadOnlyClubLogisticsData
UserPrefs .up.|> ReadOnlyUserPrefs
ModelManager .up.|> Model
Model ..> ReadOnlyClubLogisticsData
Model ..> ReadOnlyUserPrefs

ModelManager *--> "1" ClubLogisticsData
ModelManager *--> "1" UserPrefs
ModelManager --> FilteredEquipment
FilteredEquipment ..> "view of" UniqueEquipmentList

ClubLogisticsData *--> "1" UniqueEquipmentList
UniqueEquipmentList --> "0..*" Equipment
Equipment *--> "1" EquipmentId
Equipment *--> "1" EquipmentName
Equipment --> "1" EquipmentStatus
Equipment *--> "0..1 issuedTo" BorrowerName

note bottom of Equipment
  AVAILABLE has no borrower.
  ISSUED has one borrower.
end note
@enduml

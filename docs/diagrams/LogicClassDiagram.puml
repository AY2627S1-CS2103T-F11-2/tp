@startuml
!pragma layout elk
!include style.puml
skinparam arrowThickness 1.1
skinparam arrowColor LOGIC_COLOR_T4
skinparam classBackgroundColor LOGIC_COLOR

package Logic as LogicPackage {

Class "<<interface>>\nLogic" as Logic
Class LogicManager
Class ClubLogisticsParser
Class XYZCommandParser
Class CommandResult

package "Commands" as CommandClasses {
Class "{abstract}\nCommand" as Command
Class AddEquipmentCommand
Class IssueCommand
Class ReturnCommand
Class FilterCommand
}
}

package Model {
Class HiddenModel #FFFFFF
}

package Storage {
}

Class HiddenOutside #FFFFFF
HiddenOutside ..> Logic

LogicManager .right.|> Logic
LogicManager -down->"1" ClubLogisticsParser
ClubLogisticsParser ..> XYZCommandParser : <<create>>
XYZCommandParser ..> CommandClasses : <<create>>

AddEquipmentCommand -up-|> Command
IssueCommand -up-|> Command
ReturnCommand -up-|> Command
FilterCommand -up-|> Command
LogicManager .down.> Command : <<call>>

LogicManager -right-> Storage
LogicManager -down-> Model
Command .down.> Model
note left of XYZCommandParser: XYZCommandParser = AddEquipmentCommandParser, \nFilterCommandParser, etc
note bottom of CommandClasses: Representative subset. Other commands include\nRemoveCommand, ListCommand, ClearCommand,\nHelpCommand and ExitCommand.

Logic ..> CommandResult
LogicManager .down.> CommandResult
Command .up.> CommandResult : <<create>>
@enduml
